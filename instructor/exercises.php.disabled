<?php
/**
 * Instructor - Manage Exercises (Media Support)
 */

require_once('../config/functions.php');
requireInstructor();

$instructorId = $_SESSION['instructor_id'];

// Insert weight gain exercises if not present
$weightGainExercises = [
    ['name' => 'Bench Press', 'desc' => 'A compound exercise that targets the chest, shoulders, and triceps for building upper body strength.', 'diff' => 'Intermediate', 'media' => 'assets/images/Weight Gain/Bench Press.jpg'],
    ['name' => 'Chest Fly', 'desc' => 'An isolation exercise focusing on the chest muscles to enhance muscle definition.', 'diff' => 'Intermediate', 'media' => 'assets/images/Weight Gain/Chest Fly.jpg'],
    ['name' => 'Tricep Pushdown', 'desc' => 'Targets the triceps for arm development and strength.', 'diff' => 'Beginner', 'media' => 'assets/images/Weight Gain/Tricep Pushdown.jpg'],
    ['name' => 'Bicep Curl', 'desc' => 'Isolates the biceps for building arm muscle mass.', 'diff' => 'Beginner', 'media' => 'assets/images/Weight Gain/Bicep Curl.jpg'],
    ['name' => 'Hammer Curl', 'desc' => 'Works the biceps and forearms for balanced arm development.', 'diff' => 'Intermediate', 'media' => 'assets/images/Weight Gain/Hammer Curl.jpg'],
    ['name' => 'Lat Pulldown', 'desc' => 'Strengthens the back muscles, particularly the lats, for overall upper body growth.', 'diff' => 'Intermediate', 'media' => 'assets/images/Weight Gain/Lat Pulldown.jpg'],
    ['name' => 'Seated Row', 'desc' => 'Builds back strength and posture by targeting the middle back muscles.', 'diff' => 'Intermediate', 'media' => 'assets/images/Weight Gain/Seated Row.jpg']
];

foreach ($weightGainExercises as $ex) {
    $stmt = $conn->prepare("SELECT exercise_id FROM exercises WHERE name = ? AND instructor_id IS NULL");
    $stmt->bind_param("s", $ex['name']);
    $stmt->execute();
    $result = $stmt->get_result();
    if ($result->num_rows == 0) {
        $stmt2 = $conn->prepare("INSERT INTO exercises (name, description, media_path, media_type, difficulty_level) VALUES (?, ?, ?, 'image', ?)");
        $stmt2->bind_param("ssss", $ex['name'], $ex['desc'], $ex['media'], $ex['diff']);
        $stmt2->execute();
    }
}

// Handle Add/Edit Exercise
if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['action'])) {
    if ($_POST['action'] === 'add') {
        $name = sanitize($_POST['name']);
        $desc = sanitize($_POST['description']);
        $diff = sanitize($_POST['difficulty_level']);
        $mediaPath = sanitize($_POST['media_url']); // In a real app, handle file upload here. We use URL for simplicity/demo.
        $mediaType = 'image'; // Can be expanded

        $stmt = $conn->prepare("INSERT INTO exercises (instructor_id, name, description, media_path, media_type, difficulty_level) VALUES (?, ?, ?, ?, ?, ?)");
        $stmt->bind_param("isssss", $instructorId, $name, $desc, $mediaPath, $mediaType, $diff);
        
        if ($stmt->execute()) {
            redirect('exercises.php', 'Exercise added successfully!', 'success');
        } else {
            redirect('exercises.php', 'Failed to add exercise.', 'danger');
        }
    } elseif ($_POST['action'] === 'delete') {
        $exId = sanitize($_POST['exercise_id']);
        $stmt = $conn->prepare("DELETE FROM exercises WHERE exercise_id = ? AND instructor_id = ?");
        $stmt->bind_param("ii", $exId, $instructorId);
        $stmt->execute();
        redirect('exercises.php', 'Exercise deleted.', 'success');
    } elseif ($_POST['action'] === 'edit') {
        $exId = sanitize($_POST['exercise_id']);
        $name = sanitize($_POST['name']);
        $desc = sanitize($_POST['description']);
        $diff = sanitize($_POST['difficulty_level']);
        $mediaPath = sanitize($_POST['media_url']);

        $stmt = $conn->prepare("UPDATE exercises SET name=?, description=?, media_path=?, difficulty_level=? WHERE exercise_id=? AND instructor_id=?");
        $stmt->bind_param("ssssii", $name, $desc, $mediaPath, $diff, $exId, $instructorId);
        
        if ($stmt->execute()) {
            redirect('exercises.php', 'Exercise updated successfully!', 'success');
        } else {
            redirect('exercises.php', 'Failed to update exercise.', 'danger');
        }
    }
}

// Fetch exercises (own + system-wide)
$exercises = $conn->query("SELECT * FROM exercises WHERE instructor_id = $instructorId OR instructor_id IS NULL ORDER BY instructor_id DESC, created_at DESC")->fetch_all(MYSQLI_ASSOC);
?>

