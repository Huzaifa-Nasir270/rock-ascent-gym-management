    <script>
        function previewImage(url, title) {
            $('#previewImg').attr('src', url);
            $('#previewTitle').text(title);
            $('#imagePreviewModal').modal('show');
        }

        function openEditModal(ex) {
            $('#edit_ex_id').val(ex.exercise_id);
            $('#edit_name').val(ex.name);
            $('#edit_diff').val(ex.difficulty_level);
            $('#edit_media').val(ex.media_path);
            $('#edit_desc').val(ex.description);
            $('#editExerciseModal').modal('show');
        }
    </script>
